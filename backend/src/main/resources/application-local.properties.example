# Plantilla de configuración local. NO contiene credenciales reales.
# 1. Copia este archivo como application-local.properties
#    (ese archivo está ignorado por git y nunca se comparte):
#    cp application-local.properties.example application-local.properties
# 2. Reemplaza cada CAMBIAR_LOCALMENTE por tus valores de desarrollo.
# También puedes exportar las mismas claves como variables de entorno.
DB_URL=jdbc:postgresql://localhost:5432/technova_db
DB_USER=campusdesk_app
DB_PASSWORD=CAMBIAR_LOCALMENTE
JWT_SECRET=CAMBIAR_LOCALMENTE_CON_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ADMIN_EMAIL=admin.demo@CAMBIAR_LOCALMENTE
ADMIN_PASSWORD=CAMBIAR_LOCALMENTE
TECH_EMAIL=tecnico.demo@CAMBIAR_LOCALMENTE
TECH_PASSWORD=CAMBIAR_LOCALMENTE
